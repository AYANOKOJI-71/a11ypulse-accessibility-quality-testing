# Local service ports. No secrets are required for the deterministic demo.
API_PORT=4920
TARGET_PORT=5300
WEB_PORT=5202

# The API audits only one of its two built-in target keys. Do not replace this
# with an arbitrary client or production URL.
AUDIT_TARGET_BASE_URL=http://127.0.0.1:5300

# Set only when using a system-provided Chromium binary.
PLAYWRIGHT_EXECUTABLE_PATH=
